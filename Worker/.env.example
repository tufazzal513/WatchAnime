# Copy to ".env" (or set values in the hosting panel). Restart after changing a value.
PORT=3000
DB_PATH=./data/database.db
FIREBASE_PROJECT_ID=movex-513

# REQUIRED. Main server address and the key created in: Main Admin Panel -> Settings -> Servers & Backup -> Add worker
MAIN_URL=https://your-main-server
WORKER_KEY=wk_...
# This worker's own public address (so the website can find it)
PUBLIC_URL=https://your-worker-server

# Same Firebase Auth UID as the main server (used to recognise admin requests; the admin panel itself is NOT served here)
ADMIN_UID=your_firebase_auth_uid
ALLOWED_ORIGINS=*
TRUST_PROXY=1
# Safety check interval only; main pushes changes instantly
SYNC_EVERY_SEC=60
