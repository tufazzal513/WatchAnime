# ==============================================================================
# 📱 MoveX Pure-Go Backend - Environment Variables (.env.example)
# ==============================================================================
# এই ফাইলটিতে BotKeep Cloud এবং Local এ অ্যাপ চালানোর জন্য সমস্ত কনফিগারেশন
# এ টু জেড বাংলায় বুঝিয়ে দেওয়া হয়েছে।
# 
# 🟢শ্যক (Required): যেগুলো অবশ্যই সেট করতে হবে।
# 🟡 ঐচ্ছিক (Optional): না দিলেও অ্যাপ ডিফল্ট মানে চলবে।
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🟢 সার্ভার পোর্ট ও ভূমিকা (Server Core Config)
# ------------------------------------------------------------------------------

# ROLE: সার্ভারের ধরণ বা ভূমিকা।
# - "main" : মূল ব্যাকঅফিস ও মাস্টার ডাটাবেস সার্ভার।
# - "worker": ক্লাস্টার সেকেন্ডারি রিড-অনলি মিরর সার্ভার।
# প্রয়োজন: আবশ্যক (Default: main)
ROLE=main

# PORT: সার্ভারটি যে পোর্টে চলবে।
# - BotKeep Cloud এর Overview ট্যাবে Assigned Port (যেমন: 43969) দেখতে পাবেন।
# প্রয়োজন: আবশ্যক (BotKeep Cloud-এ Assigned Port দিতে হবে, Local-এ 3000)
# ডেমো মান:
PORT=43969

# DATA_DIR: SQLite ডাটাবেস (movex.db) এবং সেশন ফাইল জমা রাখার ফোল্ডার।
# প্রয়োজন: আবশ্যক (Default: ./data)
DATA_DIR=./data


# ------------------------------------------------------------------------------
# 2. 🔐 অ্যাডমিন প্যানেল লগইন (Admin SSR Credentials)
# ------------------------------------------------------------------------------

# ADMIN_USERNAME: অ্যাডমিন প্যানেলে লগইন করার ইউজারনাম বা ইমেইল।
# প্রয়োজন: ঐচ্ছিক (না দিলে ডিফল্ট "admin" হিসেবে কাজ করবে)
# ডেমো মান:
ADMIN_USERNAME=admin

# ADMIN_PASSWORD: অ্যাডমিন প্যানেলে লগইন করার সিকিউর পাসওয়ার্ড।
# প্রয়োজন: ঐচ্ছিক (না দিলে ডিফল্ট "admin123" হিসেবে কাজ করবে)
# ডেমো মান:
ADMIN_PASSWORD=admin123

# SESSION_SECRET: সেশন কুকি ও CSRF টোকেন এনক্রিপ্ট করার সিক্রেট কী (কমপক্ষে ৩২ অক্ষর)।
# প্রয়োজন: ঐচ্ছিক (না দিলে অ্যাপ অটোমেটিক সিকিউর র্যান্ডম কী জেনারেট করে নিবে)
# ডেমো মান:
SESSION_SECRET=super_secret_random_key_movex_2026_change_this


# ------------------------------------------------------------------------------
# 3. 🤖 টেলিগ্রাম অটোমেটিক ডাটাবেস ব্যাকআপ (Telegram Engine)
# ------------------------------------------------------------------------------

# TG_BOT_TOKEN: Telegram BotFather থেকে প্রাপ্ত আপনার বটের API Token।
# প্রয়োজন: ঐচ্ছিক (অটোমেটিক টেলিগ্রাম ব্যাকআপ চালু করতে চাইলে লাগবে)
# ডেমো মান:
TG_BOT_TOKEN=7123456789:AAE_ExampleTelegramBotTokenHere_XYZ

# TG_CHAT_ID: যে টেলিগ্রাম চ্যানেল বা চ্যাটে ডাটাবেস Zip ব্যাকআপ ফাইল আপলোড হবে।
# প্রয়োজন: ঐচ্ছিক (চ্যানেল আইডি সাধারণত -100 দিয়ে শুরু হয়)
# ডেমো মান:
TG_CHAT_ID=-1001234567890

# BACKUP_EVERY_HOURS: কত ঘণ্টা পর পর অটোমেটিক টেলিগ্রামে ডাটাবেস স্ন্যাপশট পাঠানো হবে।
# প্রয়োজন: ঐচ্ছিক (Default: 12 ঘণ্টা)
BACKUP_EVERY_HOURS=12

# TG_KEEP: টেলিগ্রামে বা লোকাল ফোল্ডারে সর্বোচ্চ কতটি সাম্প্রতিক ব্যাকআপ ফাইল জমা রাখা হবে।
# প্রয়োজন: ঐচ্ছিক (Default: 30)
TG_KEEP=30


# ------------------------------------------------------------------------------
# 4. 🔥 ফায়ারবেস ও ইউজার অথেন্টিকেশন (Firebase & User Auth)
# ------------------------------------------------------------------------------

# FIREBASE_PROJECT_ID: আপনার ফায়ারবেস প্রজেক্ট আইডি (ইউজার JWT টোকেন ভেরিফাই করার জন্য)।
# প্রয়োজন: ঐচ্ছিক (ইউজার রেজিস্টার/লগইন এপিআই ব্যবহার করলে লাগবে)
# ডেমো মান:
FIREBASE_PROJECT_ID=movex-513

# FIREBASE_API_KEY: ফায়ারবেস Web API Key।
# প্রয়োজন: ঐচ্ছিক
# ডেমো মান:
FIREBASE_API_KEY=AIzaSyB_ExampleFirebaseApiKey_12345

# ADMIN_UIDS: ফায়ারবেস ইউজার আইডি (UID) দিয়ে অ্যাডমিন এক্সেস দিতে চাইলে কমা দিয়ে লিখুন।
# প্রয়োজন: ঐচ্ছিক
# ডেমো মান:
ADMIN_UIDS=uid_abc123456789,uid_xyz987654321


# ------------------------------------------------------------------------------
# 5. 🌐 সিকিউরিটি ও CORS অনুমতি (CORS & Proxy Security)
# ------------------------------------------------------------------------------

# ALLOWED_ORIGINS: ফ্রন্টএন্ড (যেমন GitHub Pages) থেকে ব্যাকএন্ড এপিআই এক্সেস অনুমতি।
# প্রয়োজন: ঐচ্ছিক (Default: * অর্থাৎ সব অরিজিন এলাউ করা)
# ডেমো মান:
ALLOWED_ORIGINS=https://tufazzal513.github.io,*

# COOKIE_SECURE: HTTPS কানেকশনে কুকি Secure মোড অন রাখা (true / false)।
# প্রয়োজন: ঐচ্ছিক (Default: true)
COOKIE_SECURE=true

